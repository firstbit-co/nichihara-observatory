---
import { CONTACT, FOOTER_LINKS, NAV, SITE } from '../data/facility';
import Verify from './Verify.astro';
import { LANGS, STRINGS, type Lang } from '../data/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'ja' } = Astro.props;
const t = lang === 'ja' ? null : STRINGS[lang];
const links = t ? [...t.nav.map(([href, label]) => ({ href, label })), ...LANGS.filter((l) => l.lang !== lang)] : [...NAV, ...FOOTER_LINKS];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__name">{t ? t.name : SITE.name}</p>
      {
        t ? (
          <address>
            {t.address}<br />
            TEL <a href={`tel:+81${CONTACT.tel.value.replaceAll('-', '').slice(1)}`}>+81-{CONTACT.tel.value.slice(1)}</a>
          </address>
        ) : (
          <address>
            {CONTACT.postalCode.value && <>〒{CONTACT.postalCode.value} </>}<Verify fact={CONTACT.address} /><br />
            TEL <a href={`tel:${CONTACT.tel.value.replaceAll('-', '')}`}><Verify fact={CONTACT.tel} /></a>
          </address>
        )
      }
    </div>
    <nav aria-label={t ? t.footerNav : 'フッターメニュー'}>
      <ul>
        {links.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <p class="container site-footer__copy">© {year} {t ? t.name : SITE.name}</p>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-sunken);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-12) var(--space-6);
    font-size: 0.9rem;
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .site-footer__name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: 0;
  }
  address {
    font-style: normal;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-6);
  }
  .site-footer__copy {
    margin-top: var(--space-8);
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }
</style>
