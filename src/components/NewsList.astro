---
/** お知らせ一覧(タブ+記事の並び)。/news/ と /news/category/<tab>/ で使う */
import type { CollectionEntry } from 'astro:content';
import { formatDate, NEWS_TABS } from '../lib/content';

interface Props {
  news: CollectionEntry<'news'>[];
  /** 今のタブ。undefined は「すべて」 */
  current?: string;
}
const { news, current } = Astro.props;
const tabs = [{ slug: undefined, label: 'すべて', href: '/news/' }, ...NEWS_TABS.map((t) => ({ slug: t.slug, label: t.label, href: `/news/category/${t.slug}/` }))];
---

<nav class="news-tabs" aria-label="お知らせの種類">
  {tabs.map((t) => <a href={t.href} aria-current={t.slug === current ? 'page' : undefined}>{t.label}</a>)}
</nav>

{news.length === 0 && <p class="muted">現在お知らせはありません。</p>}
<ul class="list">
  {
    news.map((n) => (
      <li>
        <time datetime={n.data.date.toISOString()}>{formatDate(n.data.date)}</time>
        <span class="tag">{n.data.category}</span>
        <a href={`/news/${n.id}/`}>{n.data.title}</a>
      </li>
    ))
  }
</ul>

<style>
  .news-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-8) 0 var(--space-6);
  }
  .news-tabs a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-text);
  }
  .news-tabs a[aria-current='page'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #1a1200;
    font-weight: 700;
  }
</style>
