---
/**
 * トップページ。本文の文言は確定稿(docs/07-copy-rules.md)。
 * 出力される <main> の中身は確定稿の HTML と同じになるようにしている。
 * 時間・料金・休館日・受付・予約は facility.ts から差し込むので、変えるときはそちらを直す。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { CALENDAR_URL, CLOSED, FEES, HOURS, MAP_EMBED_URL, MAP_LINK_URL, RECEPTION, SORABE_URL, range, yen } from '../data/facility';
import TodaySky from '../components/TodaySky.astro';
import TopNews from '../components/TopNews.astro';
---

<BaseLayout>
  <section class="stage">
    <img class="stage-bg" src="/images/dome-night.jpg" alt="月とほうき星が浮かぶ夕暮れの空と、明かりのともった日原天文台のドーム" width="1536" height="1024" fetchpriority="high">
    <div class="stage-copy">
      <h1>日原天文台</h1>
      <p class="stage-lead">枕瀬山で、夜空をのぞく。</p>
      <p>1985年に開いた津和野町の天文台です。口径75cmの望遠鏡で、その夜の星を見ます。</p>
      <div class="actions">
        <a class="button button-gold" href="/guide/">利用案内を見る</a>
        <a class="button button-quiet" href="/access/">アクセスを見る</a>
      </div>
    </div>
  </section>

  <section class="facts" aria-label="来館の要点">
    <ul>
      <li>
        <p class="facts-label">営業日</p>
        <p class="facts-value"><a href="/guide/#days">{CLOSED.openDaysLabel}</a></p>
        <p class="facts-note">{CLOSED.weekdaysLabel}と{CLOSED.extraLabel}は休館です。</p>
      </li>
      <li>
        <p class="facts-label">開館時間</p>
        <p class="facts-value"><a href="/guide/#hours">{range(HOURS.day.start, HOURS.night.end)}</a></p>
        <p class="facts-note">昼は{range(HOURS.day.start, HOURS.day.end)}。<br>夜は{range(HOURS.night.start, HOURS.night.end)}。<br>夏季の夜は{HOURS.night.summerStart}開始。</p>
      </li>
      <li>
        <p class="facts-label">料金</p>
        <p class="facts-value">大人{yen(FEES.adult)}<br>子ども{yen(FEES.nightStudent)}</p>
        <p class="facts-note"><a href="/guide/#fees">詳細はこちら</a></p>
      </li>
    </ul>
    <p class="facts-source">開館時間は変わることがあります。料金は変わりません。</p>
  </section>


  <TodaySky />

  <TopNews />

  <section class="section" id="intro">
    <div class="wrap">
      <h2>日原天文台について</h2>
      <div class="intro-body">
        <div class="intro-text">
          <p class="intro-catch">星空の向こうに、宇宙の感動が待っています。</p>
          <p>日原(にちはら)天文台は、島根県津和野町の枕瀬山(まくらせやま)山頂、標高255mにある、豊かな自然に囲まれた公開天文台です。1985年の開台以来、40年以上にわたり、多くの人々に宇宙の神秘と星空の感動を届けてきました。</p>
          <p>天文台の主役は、口径75cmの大型反射望遠鏡。肉眼では見ることのできない遠い星々や、月のクレーター、惑星の姿など、教科書や写真でしか知らなかった宇宙の世界を、自分の目でのぞくことができます。</p>
          <p>さらに、この望遠鏡には、のちに世界最大級の光学望遠鏡の一つとなる「すばる望遠鏡」へとつながる、日本の大型望遠鏡開発の歴史が刻まれています。ここは、宇宙を楽しむだけでなく、日本の天文学の歩みにも触れられる特別な場所です。</p>
          <p>星空を見上げるだけでは味わえない、望遠鏡の向こうに広がる宇宙との出会い。</p>
          <p>子どもから大人まで、初めての方も星が大好きな方も。日原天文台で、忘れられない星空の体験をしてみませんか。</p>
          <p class="intro-catch">さあ、枕瀬山から宇宙への旅に出かけましょう。</p>
        </div>
        <figure class="intro-photo">
          <img src="/images/dome-exterior.jpg" alt="枕瀬山の山頂に立つ日原天文台。青空の下、銀色のドームと黄色い建物の前に「日原天文台」の看板が立っている" width="1536" height="1024" loading="lazy">
        </figure>
      </div>
      <p class="news-more"><a href="/about/">天文台について詳しく</a></p>
    </div>
  </section>

  <section class="section" id="calendar">
    <div class="wrap">
      <h2>予定</h2>
      <p class="section-intro">その月の予定は、カレンダーと利用案内で見てください。</p>
      <div class="calendar-frame">
        <iframe title="日原天文台のGoogleカレンダー" src={CALENDAR_URL} loading="lazy"></iframe>
      </div>
      <p><a href={CALENDAR_URL}>カレンダーを別のタブで開く</a></p>
      <p>埋め込みが表示されないときは、上のリンクからカレンダーを開いてください。</p>
      <p>予定の追加や変更が、この画面にすぐ反映されるとは限りません。</p>
    </div>
  </section>

  <section class="section" id="around">
    <div class="wrap">
      <h2>宿泊施設</h2>
      <p>宿泊施設「宙辺 -SORABE-」があります。泊まるときの料金と予約は、宙辺のサイトで確認してください。天文台への入館とは別です。</p>
      <p><a href="/sorabe/">宙辺について</a>、<a href={SORABE_URL}>宙辺 -SORABE- のサイト</a></p>
      <p>枕瀬山キャンプ場と枕瀬山森林公園も、同じ一帯にあります。<a href="/sorabe/#camp">キャンプ場の案内</a>、<a href="/around/">津和野の観光</a></p>
    </div>
  </section>

  <section class="section" id="more">
    <div class="wrap">
      <p><a href="/about/">天文台について</a>、<a href="/gallery/">写真</a></p>
    </div>
  </section>

  <section class="section" id="map">
    <div class="wrap">
      <h2>地図</h2>
      <div class="map-frame">
        <iframe title="日原天文台の地図" src={MAP_EMBED_URL} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <p><a href={MAP_LINK_URL}>Googleマップで開く</a></p>
    </div>
  </section>
</BaseLayout>
