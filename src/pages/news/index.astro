---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getNews } from '../../lib/content';

const news = await getNews();
---

<BaseLayout title="ニュース" description="日原天文台からのニュース。">
  <header class="page-header">
    <div class="container">
      <h1>ニュース</h1>
    </div>
  </header>

  <div class="container">
    {news.length === 0 && <p class="muted">現在ニュースはありません。</p>}
    <ul class="list">
      {
        news.map((n) => (
          <li>
            <time datetime={n.data.date.toISOString()}>{formatDate(n.data.date)}</time>
            <span class="tag">{n.data.category}</span>
            <a href={`/news/${n.id}/`}>{n.data.title}</a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
