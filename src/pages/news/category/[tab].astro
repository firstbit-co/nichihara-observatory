---
/** お知らせの種類ごとの一覧(タブ)。タブの定義は src/lib/content.ts の NEWS_TABS */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsList from '../../../components/NewsList.astro';
import { getNews, NEWS_TABS } from '../../../lib/content';

export function getStaticPaths() {
  return NEWS_TABS.map((tab) => ({ params: { tab: tab.slug }, props: { tab } }));
}

const { tab } = Astro.props;
const categories: readonly string[] = tab.categories;
const news = (await getNews()).filter((n) => categories.includes(n.data.category));
---

<BaseLayout title={`${tab.label}|お知らせ`} description={`日原天文台の${tab.label}。`}>
  <header class="page-header">
    <div class="container">
      <h1>{tab.label}</h1>
    </div>
  </header>

  <div class="container">
    <NewsList news={news} current={tab.slug} />
  </div>
</BaseLayout>
